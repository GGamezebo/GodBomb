<?xml version="1.0" encoding="utf-8"?>
<resources>
	<!-- Godot points windowSplashScreenBackground at the icon_background bitmap; Android 12+ expects a color
		 and falls back to a light one. Redefine the splash theme for API 31+ with a solid black color. -->
	<style name="GodotAppSplashTheme" parent="Theme.SplashScreen">
		<item name="android:windowSplashScreenBackground">#000000</item>
		<item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
		<item name="postSplashScreenTheme">@style/GodotAppMainTheme</item>
		<item name="android:windowIsTranslucent">false</item>
	</style>
</resources>
